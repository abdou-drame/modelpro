# Serveur
NODE_ENV=development
PORT=5000
# URL publique de base de ce serveur (fichiers stockés localement, ex. logo entreprise Naatalix) —
# en production, l'URL/domaine réel du backend sur le VPS.
APP_BASE_URL=http://localhost:5000

# Base de données PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/modelepro_db

# JWT — générer une chaîne aléatoire longue en production
JWT_SECRET=change_me_in_production

# Firebase Cloud Messaging (push notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary (upload photos en production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (envoi d'e-mail, OTP par e-mail Naatalix — Phase 5)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# DexPay (facturation des abonnements Naatalix)
DEXPAY_BASE_URL=https://api-sandbox.dexpay.africa/api/v1
DEXPAY_PUBLIC_KEY=
DEXPAY_SECRET_KEY=
DEXPAY_PRODUCT_ESSENTIEL_MENSUEL=
DEXPAY_PRODUCT_ESSENTIEL_ANNUEL=
DEXPAY_PRODUCT_PRO_MENSUEL=
DEXPAY_PRODUCT_PRO_ANNUEL=
DEXPAY_PRODUCT_BUSINESS_MENSUEL=
DEXPAY_PRODUCT_BUSINESS_ANNUEL=
